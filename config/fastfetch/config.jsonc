{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/bocchi-transparent.png",
    "width": 22,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭───────╮",
      "format": " "
    },
    {
      "type": "title",
      "key": "│  nme │",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "│ 󰒋 hst │",
      "format": "{host-name}"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 upt │"
    },
    {
      "type": "os",
      "key": "│ 󰣇 dst │",
      "format": "{name} {arch}"
    },
    {
      "type": "kernel",
      "key": "│  ker │",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "│  twm │",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "│  trn │",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "│  shl │",
      "format": "{pretty-name}"
    },
    {
      "type": "custom",
      "key": "├───────┤",
      "format": " "
    },
    {
      "type": "colors",
      "key": "│  clr │",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "key": "╰───────╯",
      "format": " "
    }
  ]
}
